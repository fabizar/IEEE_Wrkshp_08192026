		)
		(uuid "2ffff4d6-0a24-4bb0-ac26-bcbf5735a015")
	)
	(text "V_{rms} = V_{pk}/sqrt(2)\n120V_{rms} = 169.7V_{pk}/1.414\n\nV_{time} = A*cos(2πƒt + Θ)\n\nƒ = 60Hz\nT = 16.~{66}ms\n\nλ = v/ƒ\n%50*c/60Hz = 2.5km"
		(exclude_from_sim no)
		(at 33.274 80.772 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "376a3d0d-08a3-44c1-9a2b-97f79b4134fd")
	)
	(text "V_{DC, peak} = V_{rms}*sqrt(2) - 2V_{D}\nV_{D} = 0.7V_{DC}\n21.2V_{pk} - 1.4V = 19.8V_{DC, pk}"
		(exclude_from_sim no)
		(at 92.202 81.534 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "39ecf409-ef17-4b21-b54e-0e8f32976d5c")
	)
	(text "V_{out} = V_{Z} = 15V\n\nV_{R} = 19.8V_{DC, pk} - 15V_{Z}\nV_{R} = 4.8V_{DC}\n\nI_{R} = (V_{DC, pk} - V_{Z}) / R_{S}\nI_{R} = I_{load} + I_{Z}\nI_{Z} = (V_{DC, pk} - V_{Z}) / R_{S} - I_{load}\n\nAt I_{load} = 100mA:\nI_{Z, min} = 10mA\nI_{R} = 100mA + 10mA = 110mA\n\nR_{S} = (19.8V_{DC, pk} - 15V_{Z}) / 0.110A = 43.6Ω\n\nP_{R} = V_{R}*I_{R}\nP_{R} = 4.8V - 0.110A = 0.53W\n1 watt resistor...\n\n"
		(exclude_from_sim no)
		(at 139.446 99.568 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "668952b3-95b2-40a4-9b2f-85085d90ce74")
	)
	(text "ΔV = I_{load}/ƒ_{ripple}*C\nƒ_{ripple} = 120 Hz\n\nAt I = 100mA and C = 470uF:\nΔV = 0.1A/120Hz*0.00047F\nΔV = 1.77V\n\nSo, 19V_{DC} ±0.8V_{DC ripple}"
		(exclude_from_sim no)
		(at 115.316 79.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b2e7b69f-f122-47b9-9928-ed5523d459a6")
	)
	(text "V_{primary}/V_{secondary} = N_{primary}/N_{secondary}\nV_{p} = 120Vrms, V_{s} = 15Vrms\n120/15 = 8:1 turns\n\nI_{primary}/I_{secondary} = N_{secondary}/N_{primary}\nV_{p}I_{p} = V_{s}I_{s}\nVA = V_{secondary, rms}I_{secondary,rms}\napprox. 20VA\n\nV_{pk} = V_{rms}*sqrt(2)\n15V_{rms}*sqrt(2) = 21.2V_{pk}"
		(exclude_from_sim no)
